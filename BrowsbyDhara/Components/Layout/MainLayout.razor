
@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime

<!-- Navigation -->
<nav class="bg-gradient-to-r from-rose-400 to-pink-500 text-white shadow-lg fixed w-full top-0 z-50 backdrop-blur-sm">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <!-- Logo -->
            <div class="flex items-center">
                <h1 class="text-2xl font-bold tracking-wide cursor-pointer md:ml-2" @onclick="@(() => ScrollToTop())">
                    Brows by Dhara
                </h1>
            </div>

            <!-- Desktop Navigation -->
            <div class="hidden md:block">
                <div class="ml-10 flex items-baseline space-x-6">
                    <a href="#services" class="hover:bg-white hover:bg-opacity-20 px-3 py-2 rounded-md text-base font-medium transition-all duration-300 cursor-pointer"
                       @onclick="@(() => ScrollToSection("services"))" @onclick:preventDefault="true">Services</a>
                    <a href="#about" class="hover:bg-white hover:bg-opacity-20 px-3 py-2 rounded-md text-base font-medium transition-all duration-300 cursor-pointer"
                       @onclick="@(() => ScrollToSection("about"))" @onclick:preventDefault="true">About</a>
                    <a href="#contact" class="hover:bg-white hover:bg-opacity-20 px-3 py-2 rounded-md text-base font-medium transition-all duration-300 cursor-pointer"
                       @onclick="@(() => ScrollToSection("contact"))" @onclick:preventDefault="true">Contact</a>
                </div>
            </div>

            <!-- Mobile menu button -->
            <div class="md:hidden">
                <button class="hover:bg-white hover:bg-opacity-20 p-2 rounded-md transition-all duration-300" @onclick="ToggleMobileMenu">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile menu -->
    @if (isMobileMenuOpen)
    {
        <div class="md:hidden bg-rose-500 bg-opacity-95 backdrop-blur-sm">
            <div class="px-2 pt-2 pb-3 space-y-1">
                <a href="#services" class="block hover:bg-white hover:bg-opacity-20 px-3 py-2 rounded-md text-sm font-medium cursor-pointer transition-all duration-300"
                   @onclick="@(() => { ScrollToSection("services"); ToggleMobileMenu(); })" @onclick:preventDefault="true">Services</a>
                <a href="#about" class="block hover:bg-white hover:bg-opacity-20 px-3 py-2 rounded-md text-sm font-medium cursor-pointer transition-all duration-300"
                   @onclick="@(() => { ScrollToSection("about"); ToggleMobileMenu(); })" @onclick:preventDefault="true">About</a>
                <a href="#contact" class="block hover:bg-white hover:bg-opacity-20 px-3 py-2 rounded-md text-sm font-medium cursor-pointer transition-all duration-300"
                   @onclick="@(() => { ScrollToSection("contact"); ToggleMobileMenu(); })" @onclick:preventDefault="true">Contact</a>
            </div>
        </div>
    }
</nav>

<!-- Main Content with top padding for fixed nav -->
<main class="pt-16">
    @Body
</main>

<!-- Footer -->
<footer id="contact" class="bg-gray-800 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
                <h3 class="text-2xl font-bold text-rose-400 mb-4">Brows by Dhara</h3>
                <p class="text-gray-300 mb-4">Your beauty, our passion. Professional threading and salon services in Auburn, AL.</p>
                <div class="flex space-x-4">
                    <a href="#" class="text-gray-400 hover:text-rose-400 transition-colors">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z" />
                        </svg>
                    </a>
                    <a href="#" class="text-gray-400 hover:text-rose-400 transition-colors">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.226.085.347-.097.4-.311 1.252-.353 1.428-.055.22-.179.266-.412.161-1.499-.7-2.436-2.888-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.357-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24.009 12.017 24.009c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001 12.017.001z" />
                        </svg>
                    </a>
                    <a href="#" class="text-gray-400 hover:text-rose-400 transition-colors">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                        </svg>
                    </a>
                </div>
            </div>

            <div>
                <h4 class="text-lg font-semibold mb-4">Quick Links</h4>
                <ul class="space-y-2">
                    <li>
                        <a href="#services" class="text-gray-300 hover:text-rose-400 transition-colors cursor-pointer"
                           @onclick="@(() => ScrollToSection("services"))" @onclick:preventDefault="true">Services</a>
                    </li>
                    <li>
                        <a href="#about" class="text-gray-300 hover:text-rose-400 transition-colors cursor-pointer"
                           @onclick="@(() => ScrollToSection("about"))" @onclick:preventDefault="true">About</a>
                    </li>
                    <li>
                        <a href="#contact" class="text-gray-300 hover:text-rose-400 transition-colors cursor-pointer"
                           @onclick="@(() => ScrollToSection("contact"))" @onclick:preventDefault="true">Contact</a>
                    </li>
                </ul>
            </div>

            <div>
                <h4 class="text-lg font-semibold mb-4">Contact Info</h4>
                <div class="space-y-2 text-gray-300">
                    <p>📍 abc Street<br>Auburn, AL</p>
                    <p>📞 +1 (xxx) xxx xx xx</p>
                    <p>✉️ abc@email.com</p>
                    <div class="mt-4">
                        <p class="text-sm"><span class="font-medium">Hours:</span></p>
                        <p class="text-sm">Tue-Wed: 9am-6pm</p>
                        <p class="text-sm">Thu-Fri: 9am-7pm</p>
                        <p class="text-sm">Sat: 9am-5pm</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-t border-gray-700 mt-8 pt-8 text-center">
            <p class="text-gray-300">&copy; 2025 Brows by Dhara. All rights reserved.</p>
        </div>
    </div>
</footer>

@code {
    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private async Task ScrollToSection(string section)
    {
        await JSRuntime.InvokeVoidAsync("scrollToSection", section);
    }

    private async Task ScrollToTop()
    {
        await JSRuntime.InvokeVoidAsync("scrollToTop");
    }
}